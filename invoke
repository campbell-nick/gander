#!/bin/sh
# invoke - a small build runner for gander.
#
# A Zig-build-style front end over the Makefile: choose a step, add a few
# options, and it calls make with the right variables. Nothing here needs more
# than a POSIX shell and make.
#
#   ./invoke [step] [options]
#
# Run `./invoke --help` for the steps and options.
set -u

prog=invoke

die() {
  printf '%s: %s\n' "$prog" "$1" >&2
  exit "${2:-1}"
}

usage() {
  cat <<'EOF'
invoke - build and install gander

Usage:
  ./invoke [step] [options]

Steps (default: install):
  install     build, then install the binary, web assets and man page
  test        build, then run the test suite (make check)
  run         build, then run ./gander .
  clean       remove build artefacts
  uninstall   remove the installed binary, web assets and man page

Options:
  --prefix DIR             install prefix (default: ~/.local)
  --release                -O2 -DNDEBUG, and strip the installed binary
  --experimental[=gtk|qt]  embedded webview (auto backend, or forced)
  -h, --help               show this usage

Examples:
  ./invoke install --prefix /usr --release
  ./invoke install --experimental=qt
  ./invoke run --experimental
  ./invoke uninstall --prefix ~/.local
  ./invoke test
EOF
}

# Work from the repo root, wherever invoke was called from.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
cd "$here" || exit 1

step=
prefix=
release=0
exp=off

while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --prefix)
      [ $# -ge 2 ] || die "--prefix needs a directory" 2
      prefix=$2
      shift 2
      ;;
    --prefix=*)
      prefix=${1#--prefix=}
      shift
      ;;
    --release)
      release=1
      shift
      ;;
    --experimental)
      exp=auto
      shift
      ;;
    --experimental=*)
      exp=${1#--experimental=}
      shift
      ;;
    -*)
      die "unknown option: $1 (try --help)" 2
      ;;
    *)
      [ -z "$step" ] || die "unexpected argument: $1" 2
      step=$1
      shift
      ;;
  esac
done

[ -n "$step" ] || step=install

case "$step" in
  install | test | run | clean | uninstall) ;;
  *) die "unknown step: $step (install, test, run, clean or uninstall)" 2 ;;
esac

case "$exp" in
  off | auto | gtk | qt) ;;
  *) die "--experimental takes gtk or qt (or nothing for auto)" 2 ;;
esac

if [ -z "$prefix" ]; then
  [ -n "${HOME:-}" ] || die "HOME is not set and no --prefix was given" 2
  prefix=$HOME/.local
fi
case "$prefix" in
  "~") prefix=$HOME ;;
  "~/"*) prefix=$HOME/${prefix#\~/} ;;
esac

# ------------------------------------------------------------- webview ----- #

have_gtk() { pkg-config --exists gtk+-3.0 webkit2gtk-4.1 2>/dev/null; }
have_qt() { pkg-config --exists Qt6WebEngineWidgets 2>/dev/null; }

backend_hints() {
  cat >&2 <<'EOF'

Install a browser engine for the embedded webview:

  WebKitGTK     Gentoo: net-libs/webkit-gtk
                Debian: libgtk-3-dev libwebkit2gtk-4.1-dev
                Fedora: gtk3-devel webkit2gtk4.1-devel
                Arch:   webkit2gtk-4.1

  Qt WebEngine  Gentoo: dev-qt/qtwebengine
                Debian: qt6-webengine-dev
                Fedora: qt6-qtwebengine-devel
                Arch:   qt6-webengine

Or drop --experimental to build the default libc-only binary.
EOF
}

# WEBVIEW value for make: empty = no webview, 1 = auto, gtk/qt = forced.
# Only the steps that build need a backend; clean and uninstall do not.
wv=
if [ "$step" != clean ] && [ "$step" != uninstall ]; then
  case "$exp" in
    off) ;;
    auto)
      if have_gtk || have_qt; then
        wv=1
      else
        printf '%s: no embedded-webview backend found.\n' "$prog" >&2
        backend_hints
        exit 1
      fi
      ;;
    gtk)
      if have_gtk; then
        wv=gtk
      else
        printf '%s: the WebKitGTK backend is not installed.\n' "$prog" >&2
        backend_hints
        exit 1
      fi
      ;;
    qt)
      if have_qt; then
        wv=qt
      else
        printf '%s: the Qt Web Engine backend is not installed.\n' "$prog" >&2
        backend_hints
        exit 1
      fi
      ;;
  esac
fi

# ---------------------------------------------------------------- make ----- #

# Run make with the flags this invocation implies, plus any extra arguments.
run_make() {
  if [ "$release" = 1 ]; then
    if [ -n "$wv" ]; then
      make OPT="-O2 -DNDEBUG" WEBVIEW="$wv" "$@"
    else
      make OPT="-O2 -DNDEBUG" "$@"
    fi
  else
    if [ -n "$wv" ]; then
      make WEBVIEW="$wv" "$@"
    else
      make "$@"
    fi
  fi
}

# Can we create files under $1? Walk up to the nearest directory that exists.
writable() {
  d=$1
  while [ ! -e "$d" ] && [ "$d" != "/" ] && [ -n "$d" ]; do
    d=$(dirname "$d")
  done
  [ -w "$d" ]
}

case "$step" in
  clean)
    make clean
    ;;

  test)
    run_make check
    ;;

  run)
    run_make || exit 1
    if [ -n "$wv" ]; then
      exec ./gander . --webview
    else
      exec ./gander .
    fi
    ;;

  install)
    writable "$prefix/bin" ||
      die "cannot write to $prefix/bin (try: sudo ./invoke install --prefix $prefix)"
    run_make PREFIX="$prefix" install || exit 1
    if [ "$release" = 1 ] && command -v strip >/dev/null 2>&1; then
      strip "$prefix/bin/gander" 2>/dev/null || true
    fi
    printf '%s: installed %s/bin/gander\n' "$prog" "$prefix"
    ;;

  uninstall)
    writable "$prefix/bin" ||
      die "cannot write to $prefix/bin (try: sudo ./invoke uninstall --prefix $prefix)"
    make uninstall PREFIX="$prefix" || exit 1
    printf '%s: uninstalled %s/bin/gander\n' "$prog" "$prefix"
    ;;
esac
